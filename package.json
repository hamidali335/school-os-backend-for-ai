{
  "name": "school-os-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant AI School & Academy Operating System — backend API",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sync": "vitest run tests/sync-foundation.replset.test.ts --project replset",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "create-platform-owner": "tsx scripts/create-platform-owner.ts",
    "platform:device": "tsx scripts/platform-device.ts",
    "db:indexes": "tsx scripts/sync-indexes.ts",
    "migrate:2026-10": "tsx scripts/migrate-accounts-homework.ts",
    "migrate:retire-student-logins": "tsx scripts/migrate-retire-student-logins.ts",
    "migrate:plan-entitlements": "tsx scripts/migrate-plan-entitlements.ts",
    "migrate:session-enrollments": "tsx scripts/migrate-session-enrollments.ts",
    "backup:keygen": "tsx scripts/backup-tool.ts keygen",
    "backup:verify": "tsx scripts/backup-tool.ts verify",
    "backup:restore": "tsx scripts/backup-tool.ts restore",
    "security:inventory": "tsx scripts/endpoint-inventory.ts",
    "loadtest": "tsx scripts/load-test/run.ts",
    "docs:generate": "tsx scripts/generate-openapi.ts",
    "demo": "tsx scripts/demo-memory.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "postman:generate": "tsx scripts/generate-postman.ts",
    "ai:check": "tsx scripts/ai-check.ts",
    "push:check": "tsx scripts/push-check.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "opusscript": "0.1.1",
    "pdfjs-dist": "4.10.38",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "0.35.5",
    "swagger-ui-express": "^5.0.1",
    "werift": "0.24.4",
    "ws": "8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "8.18.1",
    "better-sqlite3": "^13.2.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
