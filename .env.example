# ─────────────────────────────────────────────────────────────────────────────
# School OS backend — environment configuration
# Copy to .env and fill in. Never commit .env. Only MONGODB_URI and the two JWT
# secrets are required; AI, messaging and other integrations are optional.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
# Interface to listen on. Empty = all interfaces (lets a phone on the same Wi-Fi reach this PC in
# development; see SchoolOSMobile/docs/LOCAL_DEVICE_SETUP.md). Behind nginx on the same host: 127.0.0.1
HOST=
# Name shown by GET /api/v1 (with a fingerprint of the database), e.g. laptop-dev or production.
INSTANCE_NAME=
APP_NAME=School OS
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Number of reverse proxies in front of the API (e.g. 1 behind nginx). Needed for correct client IPs / rate limits.
TRUST_PROXY=0
# Serve Swagger UI at /api-docs and the spec at /api-docs.json
API_DOCS_ENABLED=true

# ── Database (required) ──
# Local:  mongodb://127.0.0.1:27017/school_os
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/school_os?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/school_os
# Database name used when MONGODB_URI does not include one (otherwise MongoDB would use "test").
MONGODB_DB_NAME=school_os

# ── Authentication (required) ──
# Two DIFFERENT random secrets, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_PLATFORM_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
PLATFORM_REFRESH_TOKEN_TTL_HOURS=12
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ── CORS: the two frontends (comma separated, exact origins). Required in production. ──
# In development, when empty, any http://localhost:<port> origin is allowed.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Rate limiting (per instance, in memory) ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
# Session refreshes (POST /auth/refresh) per client IP per 15 min, separate from sign-in.
# Each session is also limited to 20 per 15 min. Size for a whole school behind one NAT.
AUTH_REFRESH_IP_MAX=1000
AI_RATE_LIMIT_PER_MINUTE=20

# App voice calls (docs/VOICE_CALLS.md). Signaling is this API (WebSocket at /api/v1/calls/socket);
# audio is WebRTC between the devices, relayed by your TURN server when a direct path fails.
# Schools also need the plan feature calls.voice (in no default plan).
CALLS_ENABLED=true
# Your own coturn server. Leave empty to allow only direct connections (same network).
CALL_STUN_URLS=
CALL_TURN_URLS=
# coturn static-auth-secret (use-auth-secret), at least 32 random characters. Never put it in an app.
CALL_TURN_SECRET=
CALL_TURN_TTL_SECONDS=4500
CALL_RING_TIMEOUT_SECONDS=45
CALL_RECONNECT_GRACE_SECONDS=20
CALL_MAX_MINUTES=60
CALL_START_PER_MINUTE=6
# Push to the Android app: incoming calls and school notifications (Firebase Cloud Messaging, free;
# docs/PUSH_NOTIFICATIONS.md). FCM_PROJECT_ID must be the project of the app's google-services.json.
# Key file: FCM_SERVICE_ACCOUNT_FILE = PATH to the Firebase Admin SDK service-account JSON, stored
# outside the repository and readable only by the API's user. Never paste the key itself here.
# Keyless alternative (docs/FCM_KEYLESS.md): FCM_CREDENTIALS=adc and GOOGLE_APPLICATION_CREDENTIALS.
FCM_PROJECT_ID=
FCM_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS=
FCM_SERVICE_ACCOUNT_FILE=
# Staging: FCM checks each message but delivers nothing.
FCM_DRY_RUN=false
# full = title and text in the push; minimal = only the kind of update (details stay in the app).
PUSH_NOTIFICATION_CONTENT=full

# AI voice conversations (docs/AI_VOICE_CALLS.md). Also needs the plan feature calls.ai_voice and the
# platform AI provider (docs/AI_PROVIDERS.md; a self-hosted Ollama works as provider "custom").
AI_CALLS_ENABLED=true
# Speech-to-text: openai_compatible = POST {URL}/audio/transcriptions (self-hosted faster-whisper server).
AI_CALL_STT_PROVIDER=none
AI_CALL_STT_URL=
AI_CALL_STT_MODEL=whisper-large-v3
AI_CALL_STT_API_KEY=
# Text-to-speech: openai_compatible = POST {URL}/audio/speech; http_wav = POST {URL} {text,language,voice} -> WAV.
AI_CALL_TTS_PROVIDER=none
AI_CALL_TTS_URL=
AI_CALL_TTS_MODEL=tts-1
AI_CALL_TTS_VOICE=
AI_CALL_TTS_API_KEY=
AI_CALL_PROVIDER_TIMEOUT_MS=20000
AI_CALL_MAX_CONCURRENT=2
AI_CALL_MAX_CONCURRENT_PER_SCHOOL=1
AI_CALL_DAILY_LIMIT_PER_SCHOOL=20
AI_CALL_MAX_MINUTES=8
AI_CALL_MAX_TURNS=20
AI_CALL_SILENCE_SECONDS=12
AI_CALL_TRANSCRIPT_RETENTION_DAYS=90

# ── Private file storage (never publicly served) ──
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# ── AI (optional) ──
# Normally managed from the platform admin panel (Platform AI Settings): provider, model and key
# are stored there (key encrypted) and can be changed at any time without a restart.
# The values below are only the FALLBACK used when nothing is saved in the panel.
# Without a key every non-AI feature keeps working.
# groq | openai | deepseek | xai | gemini | openrouter | custom | none
AI_PROVIDER=groq
# Groq keys start with gsk_ (free tier: https://console.groq.com/keys)
AI_API_KEY=
# Only for AI_PROVIDER=custom, or to override the provider's default URL.
AI_BASE_URL=
AI_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_MS=30000
# Optional: dedicated key (32+ chars) for encrypting AI keys saved in the database.
# Defaults to a key derived from JWT_PLATFORM_SECRET. Changing it means re-entering saved AI keys.
SETTINGS_ENCRYPTION_KEY=
# USD prices per 1M tokens, used for cost estimates (set from your provider's price list).
AI_INPUT_COST_PER_MTOK_USD=0
AI_OUTPUT_COST_PER_MTOK_USD=0
# Default monthly token allowance for schools without a plan; plans override it.
AI_DEFAULT_MONTHLY_TOKEN_LIMIT=500000
# Hard cap across all schools per month (0 = no platform-wide cap).
AI_PLATFORM_MONTHLY_TOKEN_LIMIT=0

# ── Email via SMTP (optional) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── SMS via Twilio (optional) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── WhatsApp Cloud API (optional) ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Per-message cost in PKR for cost tracking (messaging costs are tracked separately from AI).
MESSAGE_COST_EMAIL_PKR=0
MESSAGE_COST_SMS_PKR=0
MESSAGE_COST_WHATSAPP_PKR=0
# ── Outbound channel switches ──
# SMS, WhatsApp and email sending are PAUSED ("Coming soon") until each integration is ready.
# Turn each on independently once its credentials above are set and verified. In-app notifications
# are not affected. Changing these needs a restart.
SMS_ENABLED=false
WHATSAPP_ENABLED=false
EMAIL_SENDING_ENABLED=false


# ── Automation scheduler ──
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# ── Demo seed (development only). Password for every demo login created by `npm run seed`. ──
SEED_DEMO_PASSWORD=

# ── MongoDB topology ──
# Production refuses a standalone MongoDB: payments, admissions and onboarding need transactions
# (a single-node replica set is enough; MongoDB Atlas qualifies). Only set this to true if you
# accept that a crash in the middle of such a write can leave partial data.
ALLOW_STANDALONE_MONGODB=false

# ── Platform admin network allow-list ──
# Client IPs/CIDRs allowed to reach /api/v1/platform/* (login included). Platform admins have no
# MFA yet: restrict this to your LAN/VPN, e.g. 127.0.0.1,::1,192.168.1.0/24,100.64.0.0/10
# Needs a correct TRUST_PROXY behind nginx. Empty = unrestricted (warning in production).
# Ignored when Cloudflare Access is configured below.
PLATFORM_ALLOWED_IPS=

# ── Platform console from anywhere: Cloudflare Access (docs/PLATFORM_REMOTE_ACCESS.md) ──
# With both set, every /api/v1/platform/* request must carry a valid Cloudflare Access token for
# this application (identity check + one-time code), from any network. Not secrets.
# PLATFORM_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# PLATFORM_ACCESS_AUD=<64-character Application Audience (AUD) tag>
PLATFORM_ACCESS_TEAM_DOMAIN=
PLATFORM_ACCESS_AUD=
# Recommended: only these Access e-mails may use the platform API (comma separated).
PLATFORM_ACCESS_EMAILS=

# ── Platform console only on your own devices (docs/PLATFORM_REMOTE_ACCESS.md) ──
# true = only devices registered with `npm run platform:device -- add "My laptop"` may use the
# platform API, from any network (PLATFORM_ALLOWED_IPS is then ignored).
PLATFORM_DEVICE_ONLY=false

# Git commit of the deployed code, recorded in backup manifests (read from .git when empty).
APP_GIT_COMMIT=

# ── Backups (docs/BACKUP_RESTORE.md) ──
# 32 random bytes, base64: `npm run backup:keygen`. Backups are disabled until it is set.
# Keep a copy in your password manager AND offline: without it no backup can be restored.
BACKUP_ENCRYPTION_KEY=
# Outside STORAGE_DIR and never served by the web server.
BACKUP_DIR=./backups
BACKUP_SCHEDULE_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
BACKUP_TIMEOUT_MINUTES=60
# auto = snapshot read on a replica set, otherwise API writes pause briefly during the backup.
BACKUP_CONSISTENCY=auto
